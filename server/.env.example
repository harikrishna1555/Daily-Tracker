# Example environment variables for the server
# Copy this to `.env.development` or `.env.production` and fill values

# Server
PORT=5000

# Database (Postgres connection string)
# Local example: postgres://postgres:password@localhost:5432/daily_tracker_dev
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Password reset token lifetime (e.g. 1h, 24h)
PASSWORD_RESET_TOKEN_EXPIRES=1h

# Frontend client URL used in emails and reset links
CLIENT_URL=

# Resend (email) API key and FROM address
RESEND_API_KEY=
EMAIL_FROM=

# Developer secret for developer-only endpoints
DEVELOPER_SECRET=
# Example environment variables (safe to commit)
PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/daily_tracker
JWT_SECRET=your_jwt_secret_here
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=supersecret
NODE_ENV=development
